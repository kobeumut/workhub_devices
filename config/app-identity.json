    "appGroup": "group.com.next.workhub",
    "keychainAccessGroup": "com.next.workhub.shared"
  },
  "desktop": {
    "appId": "com.next.workhub.desktop"
  },
  "push": {
    "transport": "webpush-via-fcm-relay",
    "webPushAppTypes": "talk,workhub",
    "relayFunction": "webpush",
    "relayRegion": "europe-west1"
  }
